# A9 Protocol v15 — 环境变量模板（复制为 .env 使用，严禁将真实私钥/地址提交到仓库）

# 网络与参数文件
A9_NETWORK=testnet
# A9_PARAMS_FILE=config/testnet-fast.params.json

# Acton 钱包名称（配置在 ~/.config/acton/wallets/global.wallets.toml）
A9_DEPLOY_WALLET=deployer
A9_TREASURY_WALLET=treasury
A9_OPENER_WALLET=opener
A9_KEEPER_WALLET=keeper

# 链上地址（部署 RoundController 时写入不可变配置）
A9_KEEPER_ADDRESS=
A9_ROUND_OPENER_ADDRESS=
A9_TEAM_WALLET_ADDRESS=

# 已部署合约地址（部署完成后填入，供 round-ops.mjs 使用）
A9_JETTON_MASTER_ADDRESS=
A9_ROUND_CONTROLLER_ADDRESS=

# 推广奖励热钱包（0 合约自费 Gas 模式：用户转 0.06 TON -> 热钱包自动发 A9）
A9_PROMO_HOT_WALLET_ADDRESS=

# 真实广播门禁（默认 dry-run；真实上链必须同时传 --execute）
OPS_EXECUTE=0
OPS_CONFIRM=
# 主网额外强门禁：OPS_CONFIRM_MAINNET=YES
OPS_CONFIRM_MAINNET=
