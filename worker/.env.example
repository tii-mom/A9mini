# A9mini Worker 环境变量模板（严禁将真实私钥/API Key 提交入库）

A9_NETWORK=testnet
A9_PORT=8799

# v15 已部署合约地址
A9_JETTON_MASTER_ADDRESS=
A9_ROUND_CONTROLLER_ADDRESS=

# TonCenter / RPC 端点（只读索引 + 入账监听）
TONCENTER_API_BASE=
TONCENTER_API_KEY=

# 推广奖励热钱包配置（0 合约自费 Gas 模式）
A9_PROMO_HOT_WALLET_ADDRESS=
A9_PROMO_USER_FEE_NANO=60000000
A9_PROMO_TRANSFER_GAS_NANO=50000000
A9_PROMO_CLAIM_TTL_SECONDS=900

# Phase 1 / P0 identity. Bot token is used ONLY to verify Telegram initData signatures (never sent to clients).
A9_BOT_TOKEN=
# Comma-separated domains accepted in TON Connect ton_proof (defaults to the host of A9_PUBLIC_ORIGIN).
A9_TON_PROOF_DOMAINS=
