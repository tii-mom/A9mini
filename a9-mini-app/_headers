# Cloudflare Pages static headers for TON wallets, TonConnect 2.0 & TEP-64 token metadata

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: public, max-age=300, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate

/js/runtime-config.js
  Cache-Control: no-cache, must-revalidate

/a9.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/tonconnect-manifest.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/assets/token/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/assets/boxheads/*
  Cache-Control: public, max-age=86400

/assets/fonts/*
  Cache-Control: public, max-age=604800

/assets/brand/*
  Cache-Control: public, max-age=86400

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.a9.lat https: wss:; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
